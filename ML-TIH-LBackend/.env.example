# PostgreSQL connection (set credentials for your local instance)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace_literacy
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password

# Backend
PORT=6062
API_BASE_URL=http://localhost:6062
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set a unique long random value for local use; keep .env private.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: set once to create the first administrator, then remove these values.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Optional, one-time local administrator recovery (remove after the command).
RESET_ADMIN_USERNAME=
RESET_ADMIN_PASSWORD=
CONFIRM_ADMIN_PASSWORD_RESET=false
